{
  "name": "@fansite/db",
  "version": "0.0.0",
  "private": true,
  "description": "De database van de site en de importer: het schema, de migraties en de seed.",
  "license": "EUPL-1.2",
  "type": "module",
  "exports": {
    "./article-body-migration": "./src/article-body-migration.ts",
    "./alerts": "./src/alerts.ts",
    "./audit-log": "./src/audit-log.ts",
    "./client": "./src/client.ts",
    "./club-name-periods": "./src/club-name-periods.ts",
    "./club-stadiums": "./src/club-stadiums.ts",
    "./clubs": "./src/clubs.ts",
    "./env": "./src/env.ts",
    "./lock": "./src/lock.ts",
    "./match-changes": "./src/match-changes.ts",
    "./match-conflict-mail": "./src/match-conflict-mail.ts",
    "./match-conflicts": "./src/match-conflicts.ts",
    "./match-edits": "./src/match-edits.ts",
    "./match-lookup": "./src/match-lookup.ts",
    "./match-reports": "./src/match-reports.ts",
    "./migration-check": "./src/migration-check.ts",
    "./player-stat-differences": "./src/player-stat-differences.ts",
    "./prepare": "./src/prepare.ts",
    "./person-merge": "./src/person-merge.ts",
    "./persons": "./src/persons.ts",
    "./queries": "./src/queries.ts",
    "./schema": "./src/schema.ts",
    "./season": "./src/season.ts",
    "./season-coverage": "./src/season-coverage.ts",
    "./seed": "./src/seed.ts",
    "./source-differences": "./src/source-differences.ts",
    "./staff": "./src/staff.ts",
    "./staff-seed": "./src/staff-seed.ts",
    "./visits": "./src/visits.ts",
    "./test-database": "./src/test-database.ts"
  },
  "scripts": {
    "db:backup": "node --env-file-if-exists=../../.env src/backup-command.ts backup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "db:restore": "node --env-file-if-exists=../../.env src/backup-command.ts restore",
    "db:seed": "node --env-file-if-exists=../../.env src/seed.ts",
    "test": "node ../../scripts/worktree-env.js run -- vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fansite/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "vitest": "5.1.0"
  }
}
