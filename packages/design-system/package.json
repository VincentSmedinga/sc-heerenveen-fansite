{
  "name": "@fansite/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Huisstijl, tokens en bouwstenen van de sc Heerenveen Fansite, met Storybook als handboek.",
  "license": "EUPL-1.2",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./index.css": "./src/index.css",
    "./rich-text-editor": "./src/rich-text-editor.ts",
    "./assets/*": "./src/assets/*"
  },
  "imports": {
    "#.storybook/preview": "./.storybook/preview.tsx"
  },
  "scripts": {
    "build-storybook": "node ../../scripts/heavy-lock.js -- storybook build",
    "storybook": "node ../../scripts/worktree-env.js run --ports storybook -- storybook dev --port {STORYBOOK_PORT} --no-version-updates",
    "test": "vitest run --project unit",
    "test:stories": "node ../../scripts/heavy-lock.js -- sh -c 'STORYBOOK_THEME=light vitest run --project stories && STORYBOOK_THEME=dark vitest run --project stories'",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/truculenta": "5.3.0",
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-bold": "3.32.1",
    "@tiptap/extension-bullet-list": "3.32.1",
    "@tiptap/extension-document": "3.32.1",
    "@tiptap/extension-heading": "3.32.1",
    "@tiptap/extension-italic": "3.32.1",
    "@tiptap/extension-link": "3.32.1",
    "@tiptap/extension-list-item": "3.32.1",
    "@tiptap/extension-paragraph": "3.32.1",
    "@tiptap/extension-text": "3.32.1",
    "@tiptap/extensions": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "modern-screenshot": "4.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-mcp": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "storybook-addon-pseudo-states": "10.6.5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
