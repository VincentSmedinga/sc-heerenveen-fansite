{
  "name": "@fansite/importer",
  "version": "0.0.0",
  "private": true,
  "description": "De importer van de site: haalt koppen en links op bij de bronnen, voorlopig de fetcher en de adapter voor RSS- en Atom-feeds.",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "export:old-site": "node --env-file-if-exists=../../.env src/export-old-site.ts",
    "import": "node --env-file-if-exists=../../.env src/import.ts",
    "import:completeness": "node --env-file-if-exists=../../.env src/import.ts --completeness",
    "import:item-clubs": "node --env-file-if-exists=../../.env src/import.ts --item-clubs",
    "import:changes": "node --env-file-if-exists=../../.env src/import.ts --changes",
    "import:old-site": "node --env-file-if-exists=../../.env src/import.ts --old-site",
    "import:season": "node --env-file-if-exists=../../.env src/import.ts --season",
    "import:seasons": "node --env-file-if-exists=../../.env src/import.ts --from-season",
    "import:squad": "node --env-file-if-exists=../../.env src/import.ts --squad",
    "import:squads": "node --env-file-if-exists=../../.env src/import.ts --from-squad",
    "import:status": "node --env-file-if-exists=../../.env src/import.ts --status",
    "test": "node ../../scripts/worktree-env.js run -- vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fansite/db": "workspace:*",
    "@fansite/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "entities": "9.0.0",
    "fast-xml-parser": "5.11.2",
    "feedsmith": "3.0.1",
    "mysql2": "3.24.6",
    "undici": "8.12.3",
    "zod": "4.6.7"
  }
}
