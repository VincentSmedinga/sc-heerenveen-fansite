{
  "name": "@fansite/importer",
  "version": "0.0.0",
  "private": true,
  "description": "De importer van de site: haalt koppen en links op bij de bronnen, voorlopig de fetcher en de adapter voor RSS- en Atom-feeds.",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "import": "node --env-file-if-exists=../../.env src/import.ts",
    "import:season": "node --env-file-if-exists=../../.env src/import.ts --season",
    "import:status": "node --env-file-if-exists=../../.env src/import.ts --status",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fansite/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "entities": "7.0.1",
    "fast-xml-parser": "5.11.2",
    "feedsmith": "3.0.1",
    "undici": "8.12.3"
  }
}
