{
  "name": "@fansite/site",
  "version": "0.0.0",
  "private": true,
  "description": "De site van de sc Heerenveen Fansite, met het beheer erbij.",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "admin": "node --env-file-if-exists=../../.env src/admin.ts",
    "assemble": "node scripts/assemble.js",
    "build": "node ../../scripts/heavy-lock.js -- sh -c 'tsc -b && next build'",
    "dev": "node ../../scripts/worktree-env.js run --database --seed --ports site -- next dev --port {SITE_PORT}",
    "icons": "node scripts/make-icons.js",
    "screenshots": "node scripts/screenshots.js",
    "share-image": "node scripts/make-share-image.js",
    "smoke": "node ../../scripts/worktree-env.js run --ports smoke -- node --env-file-if-exists=../../.env scripts/smoke.js",
    "test": "node ../../scripts/worktree-env.js run -- vitest run && node --test 'scripts/*.test.js'",
    "test-data": "node scripts/test-data.js",
    "test:a11y": "node ../../scripts/heavy-lock.js -- node ../../scripts/worktree-env.js run --database --ports e2e,e2e-without-database,mail -- playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fansite/db": "workspace:*",
    "@fansite/design-system": "workspace:*",
    "@fansite/shared": "workspace:*",
    "@next/env": "16.4.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  }
}
