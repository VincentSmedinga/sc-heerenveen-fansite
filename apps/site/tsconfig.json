{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The same prefix as `imports` in package.json, which Node and Vitest read.
    // TypeScript doesn't try extensions on the target of `imports`, so a specifier without
    // `.ts` only resolves through this.
    "paths": { "#src/*": ["./src/*"] }
  },
  "include": ["e2e", "src", "next.config.ts", "playwright.config.ts", "vitest.config.ts"],
  "references": [
    { "path": "../../packages/db" },
    { "path": "../../packages/design-system" },
    { "path": "../../packages/shared" }
  ]
}
