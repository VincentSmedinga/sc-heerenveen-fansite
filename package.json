{
  "name": "sc-heerenveen-fansite",
  "version": "0.4.0",
  "private": true,
  "description": "De fansite over sc Heerenveen, sinds 1997: koppen en links, zonder advertenties.",
  "license": "EUPL-1.2",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24",
    "pnpm": "^12"
  },
  "scripts": {
    "admin:create": "pnpm --filter site run admin create",
    "admin:revoke": "pnpm --filter site run admin revoke",
    "build": "pnpm -r --workspace-concurrency=2 --if-present run build",
    "db:backup": "pnpm --filter @fansite/db db:backup",
    "db:generate": "pnpm --filter @fansite/db db:generate",
    "db:migrate": "pnpm --filter @fansite/db db:migrate",
    "db:restore": "pnpm --filter @fansite/db db:restore",
    "db:seed": "pnpm --filter @fansite/db db:seed",
    "format": "prettier --write .",
    "import": "pnpm --filter @fansite/importer run import",
    "import:changes": "pnpm --filter @fansite/importer run import:changes",
    "import:season": "pnpm --filter @fansite/importer run import:season",
    "import:seasons": "pnpm --filter @fansite/importer run import:seasons",
    "import:status": "pnpm --filter @fansite/importer run import:status",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:format",
    "lint:css": "stylelint --allow-empty-input '**/*.css'",
    "lint:format": "prettier --check .",
    "lint:js": "eslint .",
    "prepare": "husky",
    "release": "gh workflow run release.yml --ref main",
    "review": "node scripts/review.js",
    "review:stop": "node scripts/review.js --stop",
    "rollover": "node scripts/rollover.js",
    "screenshots": "pnpm --filter site screenshots",
    "test": "pnpm -r --workspace-concurrency=2 --if-present run test && node --test '.claude/hooks/*.test.js' 'baseline.test.js' 'scripts/*.test.js' 'templates.test.js'",
    "test:a11y": "pnpm --filter site test:a11y",
    "test:stories": "pnpm --filter @fansite/design-system test:stories",
    "typecheck": "tsc -b",
    "worktree:db:drop": "node scripts/worktree-env.js drop",
    "worktree:env": "node scripts/worktree-env.js"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-baseline-js": "0.7.6",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-plugin-use-baseline": "1.4.8",
    "stylelint-use-logical": "2.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
