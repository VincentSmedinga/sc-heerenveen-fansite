{
  "name": "sc-heerenveen-fansite",
  "version": "0.0.0",
  "private": true,
  "description": "De fansite over sc Heerenveen, sinds 1997: koppen en links, zonder advertenties.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24",
    "pnpm": "^12"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:format",
    "lint:css": "stylelint --allow-empty-input '**/*.css'",
    "lint:format": "prettier --check .",
    "lint:js": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-use-logical": "2.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
